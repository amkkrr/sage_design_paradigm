    "arrayMapping": "seq and heat index 0..7 maps to CSS --seq-0..7 and --heat-0..7",
    "optionalTokens": ["warning", "good-text", "grid", "seq", "heat"],
    "entityMapping": "project-defined stable IDs, independent of rank; no business names in shared tokens",
    "contrastStatus": "must be validated in each actual component and theme"
