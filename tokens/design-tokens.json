{
  "name": "Sage Design Paradigm",
  "version": "1.0.0",
  "format": "plain-json-reference-not-dtcg",
  "units": {"geometry": "px", "duration": "ms", "paddingArrays": "CSS shorthand order"},
  "scope": "Framework-neutral defaults; not an implemented component library or accessibility certification",
  "layout": {
    "boxSizing": "border-box",
    "pageMaxWidth": 1240,
    "contentMaxWidthDerived": 1176,
    "pagePadding": [28, 32, 64, 32],
    "pagePaddingAt980": [20, 16, 48, 16],
    "gridColumns": 12,
    "gutter": 16,
    "gridMarginTop": 20,
    "commonSpans": [12, 7, 5],
    "optionalSpans": [6],
    "breakpoints": [980, 600],
    "fiveKpiVariant": "minmax(260px,1.15fr) repeat(4,minmax(0,1fr))",
    "kpiPadding": [22, 20, 22, 0],
    "kpiFollowingPaddingLeft": 20,
    "masthead": {"gap": 16, "paddingBottom": 18, "sideGapRange": [8, 14]},
    "filters": {"gap": 10, "paddingY": 14, "stickyTop": 0, "trailingControlMarginLeft": "auto"},
    "footer": {"marginTop": 28, "fontSize": 12, "lineHeightRange": [1.7, 1.9]}
  },
  "typography": {
    "font": "\"Space Grotesk\", \"Noto Sans SC\", \"Noto Sans CJK SC\", \"PingFang SC\", \"Microsoft YaHei\", sans-serif",
    "mono": "\"Space Mono\", \"Noto Sans SC\", \"Noto Sans CJK SC\", ui-monospace, Menlo, Consolas, monospace",
    "body": {"size": 14, "weight": 400, "lineHeight": 1.5},
    "hero": {"size": 52, "weight": 600, "lineHeight": 1.1, "letterSpacing": "-0.02em", "unitSizeRange": [24, 26]},
    "secondary": {"size": 24, "weight": 600, "lineHeight": 1.2, "letterSpacing": "-0.01em", "unitSize": 13},
    "pageTitle": {"size": 17, "weight": 600, "letterSpacing": "0.01em"},
    "cardTitle": {"size": 14, "weight": 600},
    "control": {"size": 13, "weight": 400, "selectedWeight": 600},
    "label": {"size": 12.5, "weight": 400},
    "caption": {"sizeRange": [12, 12.5], "lineHeightRange": [1.5, 1.8]},
    "tabularNumsRecommendedFor": ["tableNumbers", "chartTicks", "rankValues", "tooltipValues", "comparableValues"]
  },
  "colors": {
    "light": {
      "page": "#c3ccb6", "surface-1": "#d8dfcf", "surface-2": "#b8c2ab",
      "ink-1": "#142d26", "ink-2": "#2f3b33", "ink-3": "#434f46",
      "grid": "#adb8a2", "axis": "#8c977f", "focus": "#2a78d6",
      "hairline": "rgba(20,28,22,0.16)", "wash": "rgba(20,28,22,0.07)",
      "s1": "#2a78d6", "s2": "#eb6834", "s3": "#169a8a", "s4": "#eda100", "s5": "#e87ba4", "other": "#858f7e",
      "good": "#0ca30c", "critical": "#d03b3b", "warning": "#fab219", "good-text": "#006300",
      "seq": ["#b8c2ab", "#cde2fb", "#9ec5f4", "#6da7ec", "#3987e5", "#256abf", "#184f95", "#0d366b"],
      "heat": ["#b8c2ab", "#8daac3", "#7195b4", "#5680a5", "#3b6b96", "#2e5a82", "#224a6e", "#18395a"]
    },
    "dark": {
      "page": "#0d0d0d", "surface-1": "#1a1a19", "surface-2": "#262624",
      "ink-1": "#ffffff", "ink-2": "#c3c2b7", "ink-3": "#898781",
      "grid": "#2c2c2a", "axis": "#383835", "focus": "#3987e5",
      "hairline": "rgba(255,255,255,0.10)", "wash": "rgba(255,255,255,0.06)",
      "s1": "#3987e5", "s2": "#d95926", "s3": "#199e70", "s4": "#c98500", "s5": "#d55181", "other": "#5d5c57",
      "good": "#0ca30c", "critical": "#d03b3b", "warning": "#fab219", "good-text": "#0ca30c",
      "seq": ["#262624", "#0d366b", "#104281", "#184f95", "#1c5cab", "#2a78d6", "#5598e7", "#9ec5f4"],
      "heat": ["#262624", "#293b4b", "#3e5366", "#536c80", "#68849b", "#7e9db5", "#94b6cf", "#abcfe9"]
