  "components": {
    "card": {"radius": 8, "padding": [16, 18, 14, 18], "optionalPaddingAt600": [16, 14, 14, 14], "headGap": 12, "headMarginBottom": 10, "shadow": "none"},
    "ghostButton": {"radius": 6, "padding": [4, 10], "fontSize": 12.5},
    "linkButton": {"radius": 4, "padding": [2, 4]},
    "seg": {"radius": 7, "padding": 2, "gap": 2, "itemRadius": 5, "itemPadding": [3, 10], "smallItemPadding": [1, 8], "smallFontSize": 12},
    "selectTrigger": {"minWidth": 70, "maxWidth": 210, "radius": 6, "padding": [3, 8], "gap": 12},
    "legendSwatch": {"width": 10, "height": 10, "radius": 2},
    "rankBar": {"height": 12, "minVisibleWidth": 2, "endRadius": 4, "valueGap": 8},
    "meter": {"height": 8, "radius": 4, "fillRadius": [4, 0, 0, 4], "background": "seq-1", "foreground": "seq-5"},
    "table": {"fontSize": 12.5, "cellPadding": [7, 10], "fixedRowHeight": null, "pageSize": null, "columnCount": null},
    "empty": {"fontSize": 13, "paddingY": 48},
    "error": {"radius": 6, "padding": [10, 14], "borderColor": "critical"},
    "tooltip": {"radius": 6, "padding": [8, 10], "fontSize": 12, "viewportInset": 8},
    "popup": {"width": 300, "padding": 10, "radius": 8, "triggerGap": 6, "viewportInset": 8, "inputMinHeight": 34, "listMaxHeight": 264},
    "optionalDialog": {"width": 540, "viewportWidthMinus": 32, "viewportHeightMinus": 48, "padding": 18, "radius": 8, "backdrop": "rgba(0,0,0,0.3)"},
    "optionalNotice": {"bottom": 24, "padding": [8, 14], "radius": 6, "duration": 3500}
  },
  "borders": {"default": "1px solid var(--hairline)", "focusWidth": 2, "focusOffset": 2, "selectionRing": "0 0 0 1px var(--hairline)"},
  "shadows": {"popupAndTooltip": "0 4px 16px rgba(0,0,0,0.08)", "card": "none"},
  "layers": {"filters": 5, "tooltip": 20, "popup": 30, "optionalNotice": 40, "modalDialog": "native top layer"},
  "motion": {
    "segGeometry": 460, "segTextColor": 180,
    "segEasing": "linear(0, 0.48 12%, 0.86 24%, 1.025 38%, 1.04 48%, 1.012 65%, 0.998 82%, 1)",
    "segFallbackEasing": "cubic-bezier(0.22,1.12,0.36,1)",
    "initialSegAnimation": false,
    "optionalLoadingOpacity": 0.55, "optionalLoadingTransition": 150,
    "optionalTooltipTransition": 80,
    "reducedMotionRequirement": "disable segmented transitions and assess all added nonessential motion"
  },
  "theme": {"cycle": ["auto", "light", "dark"], "storageKey": "project-defined", "autoDeletesOverride": true},
  "projectMustDefine": ["metrics", "formulas", "denominators", "units", "precision", "timezone", "zeroAndMissing", "dataCompleteness", "refreshMode", "thresholds", "entityColorMapping", "chartCapacity", "aggregation", "pagination", "filterScopes", "resetSemantics", "urlFields", "historyBehavior", "focusManagement", "requestRaceProtection", "exportScope"]
}
